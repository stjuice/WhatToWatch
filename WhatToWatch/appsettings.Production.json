{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "WhatToWatch": {
    "ConnectionString": "Data Source=/var/data/whattowatch.db",
    "AdminApiKey": ""
  },
  "ImdbWatchlists": {
    "CacheDirectory": "/var/data/imdb-cache",
    "BrowserProfileDirectory": "/var/data/whattowatch-imdb-profile",
    "BrowserHeadless": true,
    "StorageStatePath": "/var/data/imdb-session.json"
  }
}
