{
  "name": "whattowatch-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode capacitor",
    "build:imdb-extractor": "node scripts/build-imdb-extractor.mjs",
    "check:imdb-extractor": "node scripts/build-imdb-extractor.mjs --check",
    "preview": "vite preview",
    "cap:sync": "npm run build:imdb-extractor && npm run build:native && npx cap sync android",
    "poc:apk": "npm run cap:sync && cd android && gradlew assembleDebug",
    "poc:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "test": "npm run check:imdb-extractor && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "sass": "^1.99.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
