<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImdbMovieCatalog\ImdbMovieCatalog.csproj" />
  </ItemGroup>

  <!--
    The React client is a separate Node/Vite app. Keep its files out of the C# compile/publish
    pipeline, but let them show up as plain (non-build) files in Solution Explorer so the folder
    is visible without toggling "Show All Files". node_modules/dist are excluded since they are
    generated and can be huge.
  -->
  <ItemGroup>
    <Compile Remove="ClientApp\**" />
    <Content Remove="ClientApp\**" />
    <EmbeddedResource Remove="ClientApp\**" />
    <None Remove="ClientApp\node_modules\**" />
    <None Remove="ClientApp\dist\**" />
  </ItemGroup>

</Project>
